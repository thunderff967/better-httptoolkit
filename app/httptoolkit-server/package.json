{
  "name": "httptoolkit-server",
  "version": "1.26.1",
  "author": "Tim Perry <pimterry@gmail.com>",
  "types": "lib/index.d.ts",
  "main": "lib/index.js",
  "bin": {
    "httptoolkit-server": "./bin/run"
  },
  "files": [
    "oclif.manifest.json",
    "/bin",
    "/lib",
    "/overrides",
    "/bundle",
    "/nss"
  ],
  "scripts": {
    "preinstall": "cp ../../prepare.ts . && cp ../../overrides/js/package-lock.json overrides/js",
    "start": "node --watch ./bin/run start",
    "build:src": "npm-run-all build:src:clean build:src:ts",
    "build:src:clean": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\"",
    "build:src:ts": "tsc --build --force",
    "build:manifest": "oclif-dev manifest",
    "build:bundle": "rspack build",
    "build:pack": "tsx ./pack.ts",
    "build:release": "npm-run-all build:manifest build:bundle build:pack",
    "prepare": "tsx ./prepare.ts",
    "test": "npm-run-all test:unit test:integration",
    "test:unit": "mocha --exit 'test/unit/*.spec.ts'",
    "test:integration": "mocha --exit 'test/integration/**/*.spec.ts'",
    "test:integration:release": "cross-env TEST_BUILT_TARBALL=1 npm run test:integration"
  },
  "mocha": {
    "node-option": [
      "import=tsx"
    ]
  },
  "repository": "thunderff967/httptoolkit-server",
  "homepage": "https://github.com/thunderff967/httptoolkit-server",
  "bugs": "https://github.com/thunderff967/httptoolkit-server/issues",
  "dependencies": {
    "@oclif/command": "1.8.15",
    "@oclif/config": "1.18.2",
    "@oclif/plugin-help": "2.2.3",
    "@oclif/plugin-update": "1.5.0",
    "registry-js": "1.16.1",
    "win-version-info": "5.0.1",
    "node-datachannel": "0.12.0"
  },
  "devDependencies": {
    "@oclif/dev-cli": "^1.19.4",
    "@rspack/cli": "^1.2.2",
    "@rspack/core": "^1.2.2",
    "@sentry/webpack-plugin": "^4.3.0",
    "@types/aws-lambda": "^8.10.15",
    "@types/bluebird": "^3.5.38",
    "@types/chai": "^4.1.6",
    "@types/decompress": "^4.2.4",
    "@types/env-paths": "^1.0.2",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^8.0.0",
    "@types/klaw": "^3.0.2",
    "@types/lodash": "^4.14.117",
    "@types/mocha": "^5.2.5",
    "@types/node": "~20.11.18",
    "@types/node-forge": "^0.9.9",
    "@types/request-promise-native": "^1.0.15",
    "@types/ws": "^8.5.0",
    "axios": "^1.15.0",
    "bent": "^1.5.13",
    "chai": "^4.2.0",
    "check-msvc-runtime": "^0.1.1",
    "cross-env": "^7.0.3",
    "decompress": "^4.2.1",
    "fs-extra": "^8.1.0",
    "got": "^11.8.5",
    "graphql.js": "^0.6.1",
    "klaw": "^4.0.1",
    "mocha": "^10.8.2",
    "needle": "^2.4.0",
    "node-noop": "^1.0.0",
    "npm-run-all": "^4.1.5",
    "request": "^2.88.0",
    "request-promise-native": "^1.0.5",
    "reqwest": "^2.0.5",
    "string-replace-loader": "^3.1.0",
    "stripe": "^8.202.0",
    "superagent": "^7.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "~4.7",
    "umd-compat-loader": "^2.1.2",
    "undici": "^6.24.0",
    "unirest": "^0.6.0",
    "xhr2": "^0.2.0"
  },
  "overrides": {
    "prebuild-install": "^7.0.0"
  },
  "engines": {
    "node": "v24.15.0"
  },
  "keywords": [
    "http",
    "https",
    "proxy",
    "debugger",
    "debugging",
    "intercept",
    "httptoolkit",
    "http-toolkit"
  ],
  "license": "AGPL-3.0-or-later",
  "oclif": {
    "bin": "httptoolkit-server",
    "commands": "./lib/commands",
    "plugins": [
      "@oclif/plugin-update"
    ],
    "dependenciesToPackage": [
      "@oclif/command",
      "@oclif/config",
      "@oclif/plugin-help",
      "@oclif/plugin-update",
      "registry-js",
      "win-version-info",
      "node-datachannel"
    ],
    "update": {
      "s3": {
        "host": "https://github.com/thunderff967/httptoolkit-server/releases/download/",
        "templates": {
          "target": {
            "versioned": "v<%- version %>/<%- channel === 'stable' ? '' : channel + '-' %><%- bin %>-v<%- version %>-<%- platform %>-<%- arch %><%- ext %>",
            "manifest": "latest-manifest/<%- channel === 'stable' ? '' : channel + '-' %><%- platform %>-<%- arch %>"
          },
          "vanilla": {
            "versioned": "v<%- version %>/<%- channel === 'stable' ? '' : channel + '-' %><%- bin %>-v<%- version %><%- ext %>",
            "manifest": "latest-manifest/<%- channel === 'stable' ? '' : channel + '-' %>version"
          }
        }
      },
      "node": {
        "version": "24.15.0",
        "targets": [
          "win32-x64",
          "linux-x64",
          "darwin-x64",
          "darwin-arm64"
        ]
      }
    }
  }
}
