{
  "name": "httptoolkit",
  "productName": "httptoolkit",
  "version": "1.26.1",
  "homepage": "https://httptoolkit.com",
  "private": true,
  "description": "HTTP(S) debugging, development & testing tool HobbyistVer",
  "type": "module",
  "main": "build/index.js",
  "author": "Toolshed Labs SLU",
  "license": "AGPL-3.0-or-later",
  "config": {
    "httptoolkit-server-version": "1.26.1"
  },
  "dependencies": {
    "@httptoolkit/util": "^0.1.8",
    "@sentry/electron": "^7.2.0",
    "electron-context-menu": "^3.5.0",
    "electron-store": "^11.0.1",
    "electron-window-state": "^5.0.3",
    "get-port": "^7.2.0",
    "os-proxy-config": "^1.1.1",
    "semver": "^7.2.1",
    "tslib": "^2.8.1",
    "yargs": "^15.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "tech.httptoolkit.desktop",
    "productName": "HTTP Toolkit",
    "artifactName": "HTTP-Toolkit-${version}.${ext}",
    "extraMetadata": {
      "name": "httptoolkit",
      "productName": "httptoolkit",
      "author": "Toolshed Labs SLU"
    },
    "files": [
      "build/**/*",
      "httptoolkit-server/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "src/icons/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "src/icons/icon.ico",
      "include": "build-setup/installer-choice.nsh",
      "uninstallerIcon": "src/icons/icon.ico"
    },
    "electronVersion": "43.2.0",
    "directories": {
      "buildResources": "build-resources",
      "output": "dist"
    },
    "asarUnpack": [
      "httptoolkit-server/**/*"
    ]
  },
  "scripts": {
    "build": "tsc --noEmit --skipLibCheck || exit 0",
    "build:electron": "npm run build && npx electron-builder build --config ./build-setup/electron-builder.config.cjs"
  },
  "devDependencies": {
    "@types/electron": "^1.4.38",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
